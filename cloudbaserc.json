{
  "version": "2.0",
  "envId": "duel-room-game-d0g9srjm98caba38f",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "room-api",
      "timeout": 10,
      "memorySize": 128,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": true
      }
    },
    {
      "name": "room-cleanup",
      "timeout": 20,
      "memorySize": 128,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "installDependency": true,
      "aclRule": {
        "invoke": false
      },
      "triggers": [
        {
          "name": "cleanExpiredRoomsEveryMinute",
          "type": "timer",
          "config": "0 * * * * * *"
        }
      ]
    }
  ]
}
